{
    "name": "flavorly/laravel-helpers",
    "description": "A tool of tiny but useful Laravel Helpers that we use across our projects",
    "keywords": [
        "flavorly",
        "laravel",
        "laravel helpers"
    ],
    "homepage": "https://github.com/flavorly/laravel-helpers",
    "license": "MIT",
    "authors": [
        {
            "name": "jon",
            "email": "support@indigit.pt",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^12|^13",
        "laravel/prompts": "^0.3",
        "league/iso3166": "^4.4",
        "spatie/laravel-data": "^4.20",
        "spatie/laravel-package-tools": "^1.93",
        "spatie/laravel-typescript-transformer": "^3.0"
    },
    "require-dev": {
        "brick/money": "^0.15.0",
        "larastan/larastan": "^v3.9",
        "laravel/pint": "^1.29",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^10.9|^11.0",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "saloonphp/saloon": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Flavorly\\LaravelHelpers\\": "src"
        },
        "files": [
            "src/Helpers/generic.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Flavorly\\LaravelHelpers\\Tests\\": "tests"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Flavorly\\LaravelHelpers\\LaravelHelpersServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
